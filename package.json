{
  "name": "thoth",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @thoth/api dev\" \"pnpm --filter @thoth/web dev\"",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @thoth/api db:generate",
    "db:migrate": "pnpm --filter @thoth/api db:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
